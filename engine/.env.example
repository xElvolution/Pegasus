# Wallet that pushes oracle fee overrides on-chain.
# Must be the same EOA that was set as `oracle` in PegasusHook (set at constructor time
# in scripts/03-deploy-hook.js → defaults to deployer).
# Faucet: https://web3.okx.com/xlayer/faucet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

RPC_URL=https://testrpc.xlayer.tech
CHAIN_ID=1952

PEGASUS_HOOK_ADDRESS=0x0000000000000000000000000000000000000000
POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
POOL_SWAP_TEST_ADDRESS=0x0000000000000000000000000000000000000000
POOL_MODIFY_LIQUIDITY_TEST_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_A_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_B_ADDRESS=0x0000000000000000000000000000000000000000

TICK_SPACING=60
UPDATE_INTERVAL_MS=10000
